(defun c:PCAPSENSOR
  (/ *error* old-cmdecho old-osnapcoord undo-open)
  (setq old-cmdecho   (getvar "CMDECHO")
        old-osnapcoord (getvar "OSNAPCOORD")
        undo-open nil)

  (defun *error* (message)
    (if undo-open (command-s "_.UNDO" "_End"))
    (setvar "CMDECHO" old-cmdecho)
    (setvar "OSNAPCOORD" old-osnapcoord)
    (if (and message
             (not (wcmatch (strcase message) "*BREAK*,*CANCEL*,*EXIT*")))
      (prompt (strcat "\nPCAPSENSOR error: " message)))
    (princ))

  (setvar "CMDECHO" 0)
  (command-s "_.UNDO" "_Begin")
  (setq undo-open T)
  (pcap:generate)
  (command-s "_.UNDO" "_End")
  (setq undo-open nil)
  (setvar "CMDECHO" old-cmdecho)
  (setvar "OSNAPCOORD" old-osnapcoord)
  (prompt "\nPCAPSENSOR completed.")
  (princ))

(prompt "\nPCAP Sensor Layout Generator loaded. Run PCAPSENSOR.")
(princ)
