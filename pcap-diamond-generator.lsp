        xlmp (+ xlmp (* (+ (/ row 2) 2) da2 )))
)
)
(if (> (rem row 2) 0)
(progn
  (setq xlmp (car lmp1)
              xlmp (+ xlmp (* (+ (/ row 2) 2.5 ) da2 )))
)
)
(setq tp1 nil)
(setq lmp3 (+ row 3)
      ylmp mtx
      ylmp2 (- ylmp 20))

(repeat lmp3
  (setq xlmp (- xlmp da2 )
