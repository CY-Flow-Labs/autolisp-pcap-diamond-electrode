                (pcap:line ii ff)
                (pcap:line ff gg)
                (pcap:line gg hh)
;

    (VL-CMDF "layer" "s" "Bottom ITO" "")
    (setq col1 col)
    (while ( > col1 0 )
    (setq xa (+ xaa(* xbase1 -1))
                ya (+ yaa(* ybase1 1))
          xb (+ xaa(* xbase2 -1))
              yb (+ yaa(* ybase2 1))
                xc (+ xaa(* xbase2 -1))
                yc (+ yaa(* ybase2 -1))
                xd (+ xaa(* xbase1 -1))
                yd (+ yaa(* ybase1 -1))
          )
    (setq aa (list xa ya )
          bb (list xb yb )
          cc (list xc yc )
          dd (list xd yd )
    )
                (pcap:line aa bb)
                (pcap:line bb cc)
                (pcap:line cc dd)

    (setq col1 (- col1 1) yaa (+ yaa tx))
    )

      (setq yaa (- yaa tx))
