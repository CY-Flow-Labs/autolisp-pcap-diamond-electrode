  (setq col (pcap:getint-default  "\nSensor channels TX" 10))
  (setq row (pcap:getint-default  "\nSensor channels RX" 6))


        ;; The legacy file changed geometry according to CDATE.  That made the
        ;; same parameters produce different drawings on different days.
        ;; Preserve the normal legacy branch deterministically.
  (setq zmg 1)
  (setq mtx (* tx -0.5 (- col zmg)))
        (setq mrx (* rx -0.5 (- row zmg)))
  (setq ntx (* tx 0.5 (- col zmg)))
        (setq nrx (* rx 0.5 (- row zmg)))
        (setq dt 0.5 xaa mrx yaa mtx )

;;set bottom laser
  (setq da  (pcap:getdist-default "\nRX route spacing" 0.1))
        (setq da2 (pcap:getdist-default "\nFPC pin pitch" 0.8))



