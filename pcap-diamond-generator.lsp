;;; PCAP Sensor Layout Generator
;;; Point-for-point rewrite of the complete legacy sensor generator.
;;; Command: PCAPSENSOR
;;; Generates Top/Bottom ITO, Ag fan-out, and laser-isolation layers.

(vl-load-com)

(defun pcap:ensure-layer (name color /)
  (if (not (tblsearch "LAYER" name))
    (entmake
      (list '(0 . "LAYER")
            '(100 . "AcDbSymbolTableRecord")
            '(100 . "AcDbLayerTableRecord")
            (cons 2 name)
            '(70 . 0)
            (cons 62 color)
            '(6 . "CONTINUOUS"))))
  name)

(defun pcap:line (start end /)
  ;; Reject the zero-length LINE entities emitted by the legacy implementation.
  (if (and start end (> (distance start end) 1e-9))
    (entmakex (list '(0 . "LINE") (cons 8 (getvar "CLAYER"))
                    (cons 10 start) (cons 11 end)))))

(defun pcap:getdist-default (message default / value)
  (initget 6)
  (setq value (getdist (strcat message " <" (rtos default 2 3) ">: ")))
  (if value value default))

(defun pcap:getint-default (message default / value)
  (initget 6)
  (setq value (getint (strcat message " <" (itoa default) ">: ")))
  (if value value default))

(defun pcap:fanout-horizontal ( da pcd asw bsw ast en  / nclayer xast yast bst st xst yst xen yen xdd ydd ts xa ya xb yb xc yc aa bb cc row col)
(vl-load-com)
(setvar "OsnapCoord" 1)
  (setq xast (car ast)
        yast (cadr ast))
  (setq bst (list xast (+ yast bsw)))
  (setq st (list xast (- yast asw)))
  (setq xst (car st)
        yst (cadr st))
  (setq xen (car en)
        yen (cadr en))
  (setq nclayer (getvar "CLAYER"))
        (pcap:line bst ast)
        (pcap:line ast st)
(if (< xst (- xen (* da 2)))
(progn
  (setq col (abs (/ (- xst xen) (-(+ pcd da) (* da 1.414)) )))
  (setq xdd 0 ydd 0 ts 0 xdda 0.414)
  (while ( >= col 1 )
        (setq xa (+ xdd xst)
        ya (+ ydd yst)
        xb (+ da xdd xst)
        yb (-(+ ydd yst) da)
        xc (-(+ pcd da xdd xst)(* da 1.414))
        yc (-(+ ydd yst) da)
        aa (list xa ya )
        bb (list xb yb )
        cc (list xc yc ))
                (pcap:line aa bb)
                (pcap:line bb cc)
    (setq col (- col 1) ts (+ ts 1))
    (setq xdd (* xdda da ts -1) ydd (* ts da))
    (setq xdd (+ xdd (* pcd ts)))
    (setq ydd (* ydd -1))
  )
;last
                          (setq xa (+ xdd xst)
        ya (+ ydd yst)
        xb (+ da xdd xst)
        yb (-(+ ydd yst) da)
        xc (-(+ pcd da xdd xst)(* da 1.414))
        yc (-(+ ydd yst) da)
        aa (list xa ya )
        bb (list xb yb )
        cc (list xc yc ))
(if (< (* da 2.3) (abs (- xa xen)))
(progn
(pcap:line aa bb)
(pcap:line bb cc)
)
(pcap:line aa bb)
)
    (setq col (- col 1) ts (+ ts 1))
    (setq xdd (* xdda da ts -1) ydd (* ts da))
    (setq xdd (+ xdd (* pcd ts)))
    (setq ydd (* ydd -1))


)
)
(if (> xst (+ xen (* da 2)))
(progn
  (setq col (abs (/ (- xst xen) (-(+ pcd da) (* da 1.414)) )))
  (setq xdd 0 ydd 0 ts 0 xdda 0.414)
  (while ( >= col 1 )
        (setq xa (+ xdd xst)
        ya (+ ydd yst)
        xb (-(+ xdd xst) da)
        yb (-(+ ydd yst) da)
        xc (-(+ xdd xst (* da 1.414)) da pcd )
        yc (-(+ ydd yst) da)
        aa (list xa ya )
        bb (list xb yb )
        cc (list xc yc ))
                (pcap:line aa bb)
                (pcap:line bb cc)
    (setq col (- col 1) ts (+ ts 1))
    (setq xdd (* xdda da ts -1) ydd (* ts da))
    (setq xdd (* (+ xdd (* pcd ts)) -1))
    (setq ydd (* ydd -1))
  )
;last
                          (setq xa (+ xdd xst)
        ya (+ ydd yst)
        xb (-(+ xdd xst) da)
        yb (-(+ ydd yst) da)
        xc (-(+ xdd xst (* da 1.414)) da pcd )
        yc (-(+ ydd yst) da)
        aa (list xa ya )
        bb (list xb yb )
        cc (list xc yc ))
(if (< (* da 2.3) (abs (- xa xen)))
(progn
(pcap:line aa bb)
(pcap:line bb cc)
)
(pcap:line aa bb)
)
    (setq col (- col 1) ts (+ ts 1))
    (setq xdd (* xdda da ts -1) ydd (* ts da))
    (setq xdd (* (+ xdd (* pcd ts)) -1))
    (setq ydd (* ydd -1))

)
)


(if (< (* da 2.3) (abs (- xa xen)))
  (progn
  (VL-CMDF "_chamfer" "d" da da)
  (VL-CMDF "_chamfer" aa en)
  )
  (progn
  (VL-CMDF "_fillet" "r" 0)
  (VL-CMDF "_fillet" aa en)
  )
)
(setvar "OsnapCoord" 2)
)


