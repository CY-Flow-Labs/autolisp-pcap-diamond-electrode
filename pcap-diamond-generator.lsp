(getpoint "\n 請將鎖點關閉，在圖面點任意點開始繪圖")

;;Lbottom ito right
  (VL-CMDF "layer" "s" "Bottom ITO" "")
  (setq xangle (atan (/ tx rx)))
  (setq xbase1 (- (/ rx 2) (/ sgp (* 2 (sin xangle))))
        ybase1 (/ tx 2)
        xbase2 (/ gap 2)
        ybase2 (- (/ tx 2) ( * (/ (sin xangle)(cos xangle)) (-(-(/ rx 2)(/ sgp (* 2 (sin xangle))))(/ gap 2))))
  )

  (setq row1 row col1 col)
  (while ( > row1 0 )

      (setq xe xaa)
    (setq ye (+ yaa (* -1 (+ dt (/ tx 2)))))
